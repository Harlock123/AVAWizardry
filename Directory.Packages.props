  <!-- All versions pinned deliberately; see docs/THIRD_PARTY_NOTICES.md.
       xunit.v3 is held at 3.2.2 because Avalonia.Headless.XUnit 12.1.3 is built against xunit.v3.extensibility.core 3.2.2. -->
