<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Sound effects and music, ported from the author's AVABand (Angband.Audio). No UI dependency.
    OpenAL Soft (via Silk.NET, with native libraries for Windows, Linux and macOS on x64/ARM) does the
    mixing; NVorbis and NLayer decode Ogg Vorbis and MP3 in managed code.
  -->
  <PropertyGroup>
    <RootNamespace>Wizardry.Audio</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenAL" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" />
    <PackageReference Include="NVorbis" />
    <PackageReference Include="NLayer" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Wizardry.Core\Wizardry.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Wizardry.Core.Tests" />
  </ItemGroup>
</Project>
