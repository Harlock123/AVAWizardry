<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Wizardry.Desktop.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <FontFamily x:Key="RetroFont">avares://AVAWizardry/Assets/Fonts#VT323</FontFamily>
        <SolidColorBrush x:Key="Ink" Color="#E8E6D9" />
        <SolidColorBrush x:Key="InkDim" Color="#A9A69A" />
        <SolidColorBrush x:Key="Accent" Color="#A5A1FF" />
        <SolidColorBrush x:Key="Gold" Color="#EDE65F" />
        <SolidColorBrush x:Key="PanelBrush" Color="#16162A" />
        <SolidColorBrush x:Key="PanelBorder" Color="#34345A" />
        <SolidColorBrush x:Key="WindowBrush" Color="#0B0B14" />
        <SolidColorBrush x:Key="GoodBrush" Color="#8FD16A" />
        <SolidColorBrush x:Key="BadBrush" Color="#E0A05C" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />
        <SolidColorBrush x:Key="InfoBrush" Color="#7FC8E8" />
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock.retro">
            <Setter Property="FontFamily" Value="{StaticResource RetroFont}" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style Selector="Button.action">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="Button.menu">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontFamily" Value="{StaticResource RetroFont}" />
            <Setter Property="FontSize" Value="64" />
            <Setter Property="Foreground" Value="{StaticResource Gold}" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontFamily" Value="{StaticResource RetroFont}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
    </Application.Styles>
</Application>
