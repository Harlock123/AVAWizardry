<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wizardry.Desktop.ViewModels"
             x:Class="Wizardry.Desktop.Views.HelpView"
             x:DataType="vm:HelpViewModel">
    <Border Classes="panel" Margin="24">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Back (Esc)" Command="{Binding BackCommand}" />
            </StackPanel>
            <ListBox DockPanel.Dock="Left" Width="210" ItemsSource="{Binding Pages}" SelectedItem="{Binding Selected}" Margin="0,0,14,0" />
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Selected.Blocks}" MaxWidth="860" HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HelpBlock">
                            <Panel>
                                <TextBlock IsVisible="{Binding IsRetro}" Text="{Binding Shown}" FontSize="{Binding Size}" Margin="{Binding Margin}"
                                           FontFamily="{StaticResource RetroFont}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                                <TextBlock IsVisible="{Binding !IsRetro}" Text="{Binding Shown}" FontSize="{Binding Size}" Margin="{Binding Margin}"
                                           Foreground="{StaticResource Ink}" TextWrapping="Wrap" LineHeight="22" />
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
